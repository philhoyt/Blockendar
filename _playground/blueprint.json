{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Blockendar - Events and Calendars",
		"description": "A block-native WordPress events plugin. No shortcodes. No legacy widgets. The block editor is the UI.",
		"author": "philhoyt",
		"categories": [ "blocks" ]
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"landingPage": "/",
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Blockendar Demo",
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/philhoyt/Blockendar/releases/latest/download/blockendar.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Installing Blockendar"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/philhoyt/Blockendar/releases/latest/download/blockendar_demo.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Installing the demo content"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php';",
			"progress": {
				"caption": "Generating events and the guided tour"
			}
		}
	]
}

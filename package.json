{
  "name": "blockendar",
  "version": "1.2.0",
  "description": "Block-native WordPress events plugin",
  "license": "GPL-2.0-or-later",
  "private": true,
  "files": [
    "assets",
    "build",
    "includes",
    "lib",
    "templates",
    "languages",
    "blockendar.php",
    "uninstall.php",
    "readme.txt",
    "README.md"
  ],
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "packages-update": "wp-scripts packages-update",
    "lint:php": "vendor/bin/phpcs",
    "lint:php:fix": "vendor/bin/phpcbf",
    "plugin-zip": "wp-scripts plugin-zip",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:cli": "wp-env run cli wp",
    "make-pot": "wp-env run cli -- wp i18n make-pot wp-content/plugins/blockendar wp-content/plugins/blockendar/languages/blockendar.pot --slug=blockendar --domain=blockendar --exclude=node_modules,vendor,build,lib,tests,bin --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/philhoyt/Blockendar/issues\",\"Language-Team\":\"philhoyt <https://github.com/philhoyt/Blockendar>\"}' --allow-root",
    "test:php": "vendor/bin/phpunit",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/blockendar -- vendor/bin/phpunit -c phpunit-integration.xml",
    "test:js": "wp-scripts test-unit-js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "flatpickr": "^4.6.13",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@wordpress/env": "^11.13.0",
    "@wordpress/scripts": "^34.1.0"
  }
}

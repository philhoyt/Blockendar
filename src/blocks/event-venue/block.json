{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blockendar/event-venue",
	"version": "1.8.0",
	"title": "Event Venue",
	"category": "blockendar",
	"icon": "location",
	"description": "Displays venue name, address, and optional map embed.",
	"keywords": [
		"venue",
		"location",
		"address"
	],
	"textdomain": "blockendar",
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalWritingMode": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"attributes": {
		"showAddress": {
			"type": "boolean",
			"default": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
